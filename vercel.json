{
  "rewrites": [
    {
      "source": "/api/business/:path+",
      "destination": "/api/business?path=:path"
    },
    {
      "source": "/tour",
      "destination": "/index.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/lms/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/request/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/lab/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/validation/:path*",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "preview/i-render-backend-*": false
    }
  },
  "functions": {
    "api/business/index.js": {
      "includeFiles": "public/templates/general-performance-v1.xlsx",
      "maxDuration": 60
    }
  }
}
